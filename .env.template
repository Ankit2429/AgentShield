# AgentShield X Environment Variables Configuration Template
# Copy this file to '.env' and adjust values for your environment.
# DO NOT commit the completed '.env' file containing real secrets to Git.

# ------------------------------------------------------------------------------
# System Mode
# ------------------------------------------------------------------------------
# Set to 'production' in live hosting nodes to suppress detailed error tracebacks.
# Options: development | production
APP_ENV=development

# ------------------------------------------------------------------------------
# Security Credentials
# ------------------------------------------------------------------------------
# Replace with a strong, randomly generated alphanumeric string in production.
SECRET_KEY=dev-secret-key-change-in-production

# ------------------------------------------------------------------------------
# Datastore Configurations
# ------------------------------------------------------------------------------
# Backend Sqlite database path location.
DATABASE_URL=sqlite:///./agentshield.db
