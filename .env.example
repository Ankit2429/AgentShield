# ═══════════════════════════════════════════════════════════════════════════════
# AgentShield X — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to '.env' and adjust values for your environment.
# DO NOT commit the '.env' file containing real secrets to version control.
# ═══════════════════════════════════════════════════════════════════════════════

# ── System Mode ───────────────────────────────────────────────────────────────
# Controls error verbosity and security header strictness.
# Options: development | production
APP_ENV=development

# ── Security ──────────────────────────────────────────────────────────────────
# HMAC-SHA256 signing key for JWT tokens. MUST be changed in production.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-secret-key-change-in-production

# ── Database (PostgreSQL recommended for production) ──────────────────────────
# SQLite path for local development. Replace with PostgreSQL in production.
DATABASE_URL=sqlite:///./agentshield.db
DB_USER=agentshield
DB_PASSWORD=agentshield_pass
DB_NAME=agentshield_db

# ── Redis (Upstash recommended for production) ────────────────────────────────
# Used for rate limiting, websocket pub/sub, and distributed caching
REDIS_URL=

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (used when APP_ENV=production).
CORS_ORIGIN_WHITELIST=http://localhost:3000,http://localhost:80

# ── Frontend (Vercel) ─────────────────────────────────────────────────────────
# The public URL of the backend API, used by the React application
REACT_APP_API_URL=http://localhost:8000
